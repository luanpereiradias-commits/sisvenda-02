<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Relatórios de Vendas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { background-color: #f4f7f6; padding: 20px; }
        .card-resumo { border-left: 5px solid #0d6efd; transition: transform 0.2s; }
        .card-resumo:hover { transform: translateY(-5px); }
    </style>
</head>
<body>

<div class="container">
    <h2 class="mb-4">Dashboard de Vendas</h2>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card card-resumo shadow-sm p-3 mb-2 bg-white rounded">
                <div class="text-muted small uppercase font-weight-bold">Faturamento Total</div>
                <div class="h3 mb-0">R$ 12.450,00</div>
                <div class="text-success small">+5% desde o último mês</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-resumo shadow-sm p-3 mb-2 bg-white rounded" style="border-left-color: #198754;">
                <div class="text-muted small uppercase font-weight-bold">Vendas Realizadas</div>
                <div class="h3 mb-0">84</div>
                <div class="text-muted small">Média de 2.8 por dia</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-resumo shadow-sm p-3 mb-2 bg-white rounded" style="border-left-color: #ffc107;">
                <div class="text-muted small uppercase font-weight-bold">Produtos em Baixa</div>
                <div class="h3 mb-0">03</div>
                <div class="text-danger small">Necessita reposição</div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white font-weight-bold">Desempenho de Vendas (Últimos 7 dias)</div>
                <div class="card-body">
                    <canvas id="graficoVendas"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">Filtros de Relatório</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Período</label>
                        <select class="form-select">
                            <option>Últimos 7 dias</option>
                            <option>Últimos 30 dias</option>
                            <option>Este Ano</option>
                        </select>
                    </div>
                    <button class="btn btn-outline-primary w-100 mb-2">Gerar PDF</button>
                    <button class="btn btn-outline-success w-100" onclick="window.print()">Imprimir Relatório</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header bg-dark text-white">Últimas Transações</div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Cliente</th>
                        <th>Produtos</th>
                        <th>Status</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>07/05/2026</td>
                        <td>João Silva</td>
                        <td>1x Notebook, 2x Mouse</td>
                        <td><span class="badge bg-success">Concluída</span></td>
                        <td>R$ 3.600,00</td>
                    </tr>
                    <tr>
                        <td>06/05/2026</td>
                        <td>Maria Oliveira</td>
                        <td>1x Teclado</td>
                        <td><span class="badge bg-success">Concluída</span></td>
                        <td>R$ 120,00</td>
                    </tr>
                    <tr>
                        <td>06/05/2026</td>
                        <td>Carlos Souza</td>
                        <td>1x Monitor 24'</td>
                        <td><span class="badge bg-warning text-dark">Pendente</span></td>
                        <td>R$ 850,00</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // Lógica do Gráfico (Chart.js)
    const ctx = document.getElementById('graficoVendas').getContext('2d');
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sab', 'Dom'],
            datasets: [{
                label: 'Vendas (R$)',
                data: [1200, 1900, 800, 1500, 2500, 3200, 1300],
                borderColor: '#0d6efd',
                backgroundColor: 'rgba(13, 110, 253, 0.1)',
                fill: true,
                tension: 0.3
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false }
            }
        }
    });
</script>

</body>
</html>